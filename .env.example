HOST=127.0.0.1
PORT=3000
PROXY_API_KEY=

ZAI_BASE_URL=https://chat.z.ai
ZAI_FE_VERSION=prod-fe-1.1.52
ZAI_REGION=overseas
ZAI_LANGUAGE=pt-BR
ZAI_ACCEPT_LANGUAGE=en-US
ZAI_TIMEZONE=America/Sao_Paulo
ZAI_DEFAULT_MODEL=GLM-5.2
ZAI_ALLOW_UNLISTED_MODELS=false
ZAI_EXPERIMENTAL_MODELS=
ZAI_MAX_INLINE_IMAGE_BYTES=2097152

DATA_DIR=./data
RUNTIME_DIR=./runtime
FILE_STORE_DIR=./data/files
DATABASE_PATH=./data/proxy.sqlite
MASTER_KEY_PATH=./data/master.key

CAPTCHA_HEADLESS=true
CAPTCHA_KEEP_BROWSER_OPEN=true
CAPTCHA_TIMEOUT_MS=180000
BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=

PROXY_NATIVE_TOOLS=true
PROXY_NATIVE_TOOLS_AUTO=false
PROXY_TOOLS_ALLOW_COMMANDS=false
PROXY_TOOLS_ROOT=.
PROXY_TOOLS_MAX_FILE_BYTES=1048576
PROXY_TOOLS_MAX_WRITE_BYTES=1048576
PROXY_TOOLS_MAX_ROUNDS=6
